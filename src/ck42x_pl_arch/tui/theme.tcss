/* CK42X PL-ARCH — nyanBEE black + gold console */

Screen {
    background: #0a0a08;
}

#main-header {
    height: auto;
    padding: 1 2;
    border: none;
    background: #0a0a08;
    color: #ffd400;
    text-align: center;
}

#menu-panel {
    border: round #4a4200;
    background: #0f0e08;
    padding: 1 2;
    margin: 0 2 1 2;
    height: 1fr;
    min-height: 8;
}

.menu-item {
    height: 3;
    padding: 0 1;
    margin: 0 0 1 0;
    background: #141208;
    color: #e8e0c8;
}

.menu-item.-active {
    background: #1f1a00;
    border: tall #ffd400;
    color: #ffea00;
    text-style: bold;
}

.menu-item.-muted {
    color: #5c5530;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: #ffd400;
    color: #0a0a08;
    padding: 0 1;
    text-style: bold;
}

#footer-hint {
    dock: bottom;
    height: 1;
    offset: 0 -2;
    color: #6b6030;
    padding: 0 2;
}

Footer {
    background: #0a0a08;
    color: #8a7a40;
}

Footer > .footer--key {
    color: #ffd400;
    text-style: bold;
}

Footer > .footer--description {
    color: #c8b860;
}

Form Label {
    color: #d4c878;
    margin-top: 1;
}

Input, TextArea, Select {
    border: tall #3a3500;
    background: #0c0b06;
    color: #fff8dc;
}

Input:focus, TextArea:focus {
    border: tall #ffd400;
}

Checkbox {
    background: #0c0b06;
    color: #e8e0c8;
}

Checkbox:focus {
    border: tall #ffd400;
}

Button.primary {
    background: #ffd400;
    color: #0a0a08;
    text-style: bold;
    border: tall #ffea00;
}

Button.primary:hover {
    background: #ffea00;
}

Button {
    background: #1a1808;
    color: #e8e0c8;
    border: tall #4a4200;
}

Button:hover {
    background: #252010;
    border: tall #665c00;
}

RichLog {
    border: round #3a3500;
    background: #060605;
    color: #e8e0c8;
}

#log-panel {
    border: round #3a3500;
    background: #060605;
    height: 1fr;
    padding: 1;
}
