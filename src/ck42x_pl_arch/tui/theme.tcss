Screen {
    background: #06080c;
}

#main-header {
    height: auto;
    padding: 1 2;
    border: heavy #00d4aa;
    background: #0c1018;
    color: #e8f4ff;
}

#brand-title {
    text-style: bold;
    color: #00e5ff;
}

#brand-sub {
    color: #6b7d93;
}

#menu-panel {
    border: round #1a3a4a;
    background: #0a0e14;
    padding: 1 2;
    margin: 1 2;
}

.menu-item {
    height: 3;
    padding: 0 1;
    margin: 0 0 1 0;
    background: #0f141c;
}

.menu-item.-active {
    background: #102a35;
    border: tall #00e5ff;
    color: #00e5ff;
    text-style: bold;
}

.menu-item.-muted {
    color: #4a5a6a;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: #00d4aa;
    color: #06080c;
    padding: 0 1;
    text-style: bold;
}

#footer-hint {
    dock: bottom;
    height: 1;
    offset: 0 -2;
    color: #4a6070;
    padding: 0 2;
}

Form Label {
    color: #8ab4d4;
    margin-top: 1;
}

Input, TextArea, Select {
    border: tall #1e3a4a;
    background: #0c1218;
    color: #e0f0ff;
}

Input:focus, TextArea:focus {
    border: tall #00e5ff;
}

Checkbox {
    background: #0c1218;
    color: #c8dce8;
}

Button.primary {
    background: #00d4aa;
    color: #06080c;
    text-style: bold;
}

Button {
    background: #1a2838;
    color: #c8dce8;
    border: tall #2a4050;
}

#log-panel {
    border: round #2a2030;
    background: #080a0e;
    height: 1fr;
    padding: 1;
}
